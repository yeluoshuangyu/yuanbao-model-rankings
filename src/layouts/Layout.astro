---
import '../styles/global.css';
import '../styles/design.css';
import '../styles/features.css';
import '../styles/theme.css';
import CommunityFooter from '../components/CommunityFooter.astro';
import { pathFor } from '../lib/render';
interface Props { title?: string; description?: string }
const { title = '价格排行榜 · 源宝模型排行榜', description = '比较主流 AI 模型的官方 API 价格、任务成本与性能，关注源宝的大模型科目三。让每个人都用得上、用得起 AI。' } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="源宝模型排行榜" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#f5f5f7" />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('yuanbao:theme');
          if (saved === 'dark' || saved === 'light') document.documentElement.dataset.theme = saved;
        } catch (error) {}
        const root = document.documentElement;
        const dark = root.dataset.theme === 'dark' || (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', dark ? '#0c0c0e' : '#f5f5f7');
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href={pathFor(base, 'favicon.svg')} />
    <link rel="alternate" type="application/atom+xml" title="源宝模型排行榜 · 上架与调价" href={pathFor(base, 'feed.xml')} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <header class="site-header">
      <div class="header-inner">
        <div class="wordmark"><a class="brand-avatar-link" href="https://space.bilibili.com/38061207" target="_blank" rel="noopener noreferrer" aria-label="访问源宝的 B 站主页（新窗口打开）" title="源宝的 B 站主页"><img class="brand-avatar" src={pathFor(base, 'gityuanbao-avatar.jpg')} alt="" width="34" height="34" /></a><span>源宝模型排行榜</span></div>
        <nav aria-label="主导航">{[
          ['', '价格排行榜'],
          ['value/', '性价比'],
          ['compare/', '模型对比'],
          ['performance/', '性能排行榜'],
          ['pelican/', '大模型科目三'],
          ['api/', '开放数据'],
        ].map(([path, label]) => {
          const href = pathFor(base, path);
          const active = Astro.url.pathname === href;
          return <a class:list={{ active }} aria-current={active ? 'page' : undefined} href={href}>{label}</a>;
        })}</nav>
        <button class="theme-toggle" type="button" aria-label="切换深色模式" aria-pressed="false" title="切换深色模式">
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2" /><path d="M12 2.4v2.4M12 19.2v2.4M2.4 12h2.4M19.2 12h2.4M5.1 5.1l1.7 1.7M17.2 17.2l1.7 1.7M18.9 5.1l-1.7 1.7M6.8 17.2l-1.7 1.7" /></svg>
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M20.5 14.6A8.6 8.6 0 0 1 9.4 3.5a8.6 8.6 0 1 0 11.1 11.1Z" /></svg>
        </button>
      </div>
    </header>
    <slot />
    <CommunityFooter />
  </body>
</html>
<script>
  import '../scripts/motion';
  import '../scripts/theme';
</script>
